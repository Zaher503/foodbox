# Optional: auto-generated into this file on first run if you skip it. Used by POST /api/add (X-Recipe-Key header).
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RECIPE_KEY=change-me

# Optional: "Add to Groceries" button (Google Keep). Use a throwaway Google account that the real
# Groceries note is shared with; the master token gives full access to the account it belongs to.
KEEP_EMAIL=
KEEP_MASTER_TOKEN=
KEEP_LIST=Groceries
