# Optional: auto-generated into this file on first run if you skip it. Used by POST /api/add (X-Recipe-Key header).
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RECIPE_KEY=change-me

# Optional: "Add to Groceries list" button. Sends a Home Assistant push notification titled "Groceries"
# with the uncrossed ingredients, one per line. HA_TOKEN is a long-lived access token.
HA_URL=http://192.168.0.108:8123
HA_TOKEN=
HA_NOTIFY_SERVICE=mobile_app_zahers_17pm
