[Unit]
Description=Foodbox recipe saver
After=network-online.target docker.service

[Service]
User=foodbox
WorkingDirectory=/opt/foodbox/app
EnvironmentFile=/opt/foodbox/.env
ExecStart=/opt/foodbox/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8800
Restart=on-failure

[Install]
WantedBy=multi-user.target
